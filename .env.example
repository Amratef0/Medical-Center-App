# Database Connection
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=password
DB_NAME=mcsos_db

# Application Config
PORT=3000
NODE_ENV=development
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
DB_SSL=false
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100
THROTTLE_LOGIN_LIMIT=5
THROTTLE_LOGIN_TTL_MS=900000

# JWT Secret Keys
JWT_ACCESS_SECRET=your_super_secret_access_key_here
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_super_secret_refresh_key_here
JWT_REFRESH_EXPIRES_IN=7d

# WhatsApp (default mock never marks rows SENT)
WHATSAPP_PROVIDER=mock
# WHATSAPP_META_TOKEN=
# WHATSAPP_META_PHONE_NUMBER_ID=
# WHATSAPP_WEBHOOK_SECRET=

# File storage (T-011) — local driver needs no cloud credentials
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=uploads
# Optional: defaults to JWT_ACCESS_SECRET for signed download URLs in local mode
# STORAGE_DOWNLOAD_SECRET=

# S3 / Cloudflare R2 (when STORAGE_DRIVER=s3; client stub — configure before production)
# S3_BUCKET=
# S3_REGION=auto
# S3_ENDPOINT=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
